{
  "format": "pd/0.1",
  "meta": {
    "name": "Long desk tray (2-piece, dovetail)",
    "description": "A desk tray longer than most print beds, split in the middle and joined with dovetails in the thick floor.",
    "category": "storage/trays",
    "tags": ["tray", "desk", "multi-part", "dovetail"],
    "license": "CC-BY-4.0",
    "skills": ["core-parametric", "printability", "multi-part", "connector-dovetail"]
  },
  "params": {
    "length": { "value": 320, "min": 200, "max": 450, "unit": "mm", "label": "Length", "group": "Size" },
    "width":  { "value": 90, "min": 50, "max": 200, "unit": "mm", "label": "Width", "group": "Size" },
    "height": { "value": 25, "min": 12, "max": 60, "unit": "mm", "label": "Inside height", "group": "Size" },
    "wall":   { "value": 2.4, "min": 1.6, "max": 4, "step": 0.2, "unit": "mm", "label": "Wall", "group": "Strength", "advanced": true },
    "floor":  { "value": 5, "min": 4, "max": 8, "step": 0.5, "unit": "mm", "label": "Floor (holds the dovetails)", "group": "Strength", "advanced": true },
    "fit":    { "value": 0.15, "min": 0.05, "max": 0.4, "step": 0.05, "unit": "mm", "label": "Dovetail clearance", "group": "Fit", "advanced": true }
  },
  "parts": [
    {
      "id": "tray",
      "shape": { "type": "hollow_box", "outer": ["length", "width", "height + floor"], "wall": "wall", "floor": "floor", "radius": 6 },
      "color": "#7b2cbf"
    }
  ],
  "splits": [
    {
      "part": "tray", "axis": "x", "at": 0,
      "names": ["tray_left", "tray_right"],
      "joint": { "type": "dovetail", "count": 2, "width": 10, "depth": 8, "clearance": "fit" }
    }
  ],
  "print": { "bed": [256, 256, 256] }
}
