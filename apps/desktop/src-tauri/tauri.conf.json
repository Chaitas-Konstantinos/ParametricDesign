{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParametricDesign",
  "version": "0.2.1",
  "identifier": "app.parametricdesign.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ParametricDesign", "width": 1400, "height": 900, "minWidth": 900, "minHeight": 600, "dragDropEnabled": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "fileAssociations": [{ "ext": ["pd.json"], "name": "ParametricDesign design", "role": "Editor" }]
  }
}
